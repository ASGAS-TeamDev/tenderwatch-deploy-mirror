[Unit]
Description=Tender Watch backend (FastAPI / uvicorn)
After=network.target

[Service]
Type=simple
User=tender-watch
Group=tender-watch
WorkingDirectory=/opt/tender-watch/backend
EnvironmentFile=/etc/tender-watch/backend.env
# Loopback-only; nginx reverse-proxies /api/* here. Port 8001 chosen to
# avoid collision with the TITAN Node API on 127.0.0.1:3000.
ExecStart=/opt/tender-watch/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/tender-watch
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
