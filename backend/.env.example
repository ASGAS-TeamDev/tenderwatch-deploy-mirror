# eTenders OCDS Public API base
TW_API_BASE=https://ocds-api.etenders.gov.za

# Where the user-editable config JSON lives.
# Dev: ./config/tender-watch.json (relative to backend/).
# Production (nginx + systemd): /etc/tender-watch/config.json.
TW_CONFIG_PATH=./config/tender-watch.json

# In-memory response cache TTL
TW_CACHE_TTL_SECONDS=60

# Comma-separated CORS origins.
# Dev (Vite at :5173, backend at :8000): http://localhost:5173
# Production (same-origin via nginx reverse-proxy): leave empty.
TW_ALLOWED_ORIGINS=http://localhost:5173

# Log level
TW_LOG_LEVEL=INFO

# Postgres connection for the nightly n8n-synced tender data
# (tenders/sync_runs tables). Leave empty for local dev — the backend
# falls back to fetching live from eTenders on every request, same as
# before this existed. Set in production so the app reads from Postgres
# instead of hitting the live API on the request path.
# e.g. postgresql://tender_watch_app:<password>@156.38.222.220:5432/tender_watch
TW_DATABASE_URL=

# Anthropic API key for the "Executive Overview" tender summarization
# feature (not yet implemented — see project discussion). Leave unset
# to disable that feature.
TW_ANTHROPIC_API_KEY=
